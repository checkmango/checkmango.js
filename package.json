{
  "name": "@checkmango/checkmango.js",
  "description": "The official Checkmango Javascript SDK.",
  "version": "0.2.0",
  "author": "Checkmango",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "homepage": "https://github.com/checkmango/checkmango.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/checkmango/checkmango.js.git"
  },
  "bugs": {
    "url": "https://github.com/checkmango/checkmango.js/issues"
  },
  "keywords": [
    "api",
    "checkmango",
    "javascript",
    "typescript"
  ],
  "files": [
    "./dist/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm test",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run typecheck && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
